#include <zephyr/dt-bindings/gpio/gpio.h>

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpio2 { status = "okay"; };
&gpiote20 { status = "okay"; };
&gpiote30 { status = "okay"; };

/ {
    chosen {
        zephyr,console = &uart30;
        zephyr,shell-uart = &uart30;
    };

    ads_bitbang_pins: ads-bitbang-pins {
        compatible = "gpio-leds";
        ads_bb_sck: ads-bb-sck { gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>; };
        ads_bb_mosi: ads-bb-mosi { gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>; };
        ads_bb_miso: ads-bb-miso { gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>; };
        ads_bb_cs: ads-bb-cs { gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>; };
        ads_bb_start: ads-bb-start { gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>; };
        ads_bb_reset: ads-bb-reset { gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>; };
    };

    aliases {
        ads-bb-sck = &ads_bb_sck;
        ads-bb-mosi = &ads_bb_mosi;
        ads-bb-miso = &ads_bb_miso;
        ads-bb-cs = &ads_bb_cs;
        ads-bb-start = &ads_bb_start;
        ads-bb-reset = &ads_bb_reset;
    };
};

&uart30 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart30_default>;
    pinctrl-1 = <&uart30_sleep>;
    pinctrl-names = "default", "sleep";
};





&button1 { status = "disabled"; };  /* P1.09 / MB_TX */
&button2 { status = "disabled"; };  /* P1.08 / MB_RX */


&button0 { status = "disabled"; };  /* P1.13 / ADS /PWDN diagnostic */


