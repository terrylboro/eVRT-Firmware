#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&gpio1 { status = "okay"; };
&gpio2 { status = "okay"; };
&gpiote20 { status = "okay"; };
&clock { status = "okay"; };

&pinctrl {
    ads_spi_default: ads_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
                    <NRF_PSEL(SPIM_MOSI, 2, 2)>;
        };
        group2 {
            psels = <NRF_PSEL(SPIM_MISO, 2, 4)>;
            bias-pull-up;
        };
    };
    ads_spi_sleep: ads_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
                    <NRF_PSEL(SPIM_MOSI, 2, 2)>,
                    <NRF_PSEL(SPIM_MISO, 2, 4)>;
            low-power-enable;
        };
    };
};

/* Disable spi20 so it doesn't conflict with uart20 */
&spi20 { status = "disabled"; };

/* Use spi00: it has been verified on the logic analyser. */
&spi00 {
    status = "okay";
    pinctrl-0 = <&ads_spi_default>;
    pinctrl-1 = <&ads_spi_sleep>;
    pinctrl-names = "default", "sleep";
    ads1292r: adc@0 {
        compatible = "ti,ads1292r";
        reg = <0>;
        spi-max-frequency = <1280000>;
        spi-cpha;
        cs-gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
        start-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
        drdy-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
    };
};


